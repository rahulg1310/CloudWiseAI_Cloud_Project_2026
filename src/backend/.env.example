DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudwise
JWT_SECRET=change-me-to-a-long-random-string
# comma-separated; add your deployed frontend URL here later
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# AI assistant. LLM_PROVIDER is "ollama" (local, free), "anthropic" (Claude) or "openai".
# ollama needs no key: run `ollama pull llama3.1:8b` once and keep Ollama running.
# anthropic and openai need LLM_API_KEY; leave it empty to disable the assistant for those.
LLM_PROVIDER=ollama
LLM_API_KEY=
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
